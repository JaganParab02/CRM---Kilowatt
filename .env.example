# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# AI Provider Configuration (Server-side only — never expose to client)
GROQ_API_KEY=your-groq-api-key

# Email Provider Configuration (Resend)
# If left blank, the application will operate safely in Demo Mode (simulated emails)
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=CommercePilot <orders@yourdomain.com>
